# ---------------------------------------------------------------------------
# Elige UN proveedor: descomenta su clave y ajusta LLM_MODEL en consecuencia.
# La sintaxis del modelo es la de litellm: proveedor/nombre-del-modelo
# ---------------------------------------------------------------------------

# --- Anthropic (por defecto) ---
ANTHROPIC_API_KEY=sk-ant-...
LLM_MODEL=anthropic/claude-sonnet-4-5

# --- OpenAI ---
# OPENAI_API_KEY=sk-...
# LLM_MODEL=openai/gpt-4o

# --- Google ---
# GEMINI_API_KEY=...
# LLM_MODEL=gemini/gemini-3.5-flash

# --- Mistral ---
# MISTRAL_API_KEY=...
# LLM_MODEL=mistral/mistral-large-latest

# --- Groq ---
# GROQ_API_KEY=...
# LLM_MODEL=groq/llama-3.3-70b-versatile

# --- DeepSeek. Exige clave; no necesita LLM_API_BASE ---
# Dos modelos vigentes: deepseek-flash (económico) y deepseek-v4-pro.
# deepseek-chat, deepseek-reasoner y deepseek-v4-flash están retirados.
# Alias: su contenido puede cambiar. Anotá la fecha de corrida.
# Con DeepSeek poné LLM_REASONING_EFFORT=none: es el único valor que apaga el
# razonamiento, y encendido agota los 1600 tokens de LLM_MAX_TOKENS antes de
# cerrar el JSON, así que la respuesta se trunca siempre.
# DEEPSEEK_API_KEY=sk-...
# LLM_MODEL=deepseek/deepseek-flash
# LLM_REASONING_EFFORT=none

# --- Ollama local, sin clave. Requiere ollama corriendo en el host ---
# Usa el prefijo ollama_chat/ (endpoint /api/chat) y no ollama/: es el que
# litellm recomienda para conversaciones.
# LLM_MODEL=ollama_chat/gemma3:4b
# LLM_API_BASE=http://host.docker.internal:11434

# --- Parámetros comunes ---
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=1600

# Endpoint alternativo compatible con la API del proveedor. Vacío o ausente = no
# se envía, y cada proveedor en la nube resuelve su URL como siempre. Se usa para
# servidores locales (Ollama, LM Studio), proxies o gateways.
# Desde el contenedor, el host se alcanza por host.docker.internal.
# LLM_API_BASE=http://host.docker.internal:11434

# Semilla de muestreo, opcional. Vacía o ausente = no se envía. Con
# temperature=0 reduce la varianza entre corridas en los proveedores que la
# respetan (Ollama, OpenAI); los demás la descartan vía drop_params.
# LLM_SEED=42

# Segundos de espera por respuesta antes de abortar la llamada.
LLM_TIMEOUT=90

# Esfuerzo de razonamiento. Solo aplica a modelos que razonan (Gemini 3.x,
# o-series, etc.); en el resto litellm lo descarta gracias a drop_params.
# Valores: minimal | low | medium | high | none. Vacío = no se envía.
#
# OJO: litellm traduce este valor al dialecto de cada proveedor, y el mismo
# valor NO significa lo mismo en todos. Verificado capturando el cuerpo HTTP:
#   · Ollama:   minimal se traduce a think:false, o sea razonamiento apagado.
#   · DeepSeek: solo el literal none lo apaga (manda thinking:{type:disabled}).
#               Cualquier otro valor no vacío, minimal incluido, lo ENCIENDE.
# Si cambiás de proveedor, revisá este valor: no se traslada.
#
# IMPORTANTE: los modelos que razonan descuentan los tokens de razonamiento del
# mismo presupuesto de LLM_MAX_TOKENS. Medido sobre gemini-3.5-flash con la
# historia de referencia de check.py: con "high" implícito gasta ~2391 tokens
# razonando contra ~407 de texto útil, y 1600 no alcanza (la respuesta se trunca
# a medio JSON). Con "minimal" ahí el razonamiento es 0 y 1600 sobra; en
# DeepSeek ese mismo "minimal" lo enciende y hace falta "none".
LLM_REASONING_EFFORT=minimal

# Modo del experimento. false (por defecto) = dos llamadas al modelo: una
# evalúa y otra complementa. true = el prompt original, que hace las dos cosas
# en una sola llamada. Existe para poder comparar ambos diseños con la misma
# rúbrica; en desacoplado el veredicto lo deriva Python a partir del tipo de
# cada falla, no el modelo.
MODO_ACOPLADO=false

# Detector determinista de requirement smells (Zakeri-Nasrabadi y Parsa, 2024).
# Siempre se calcula y siempre viaja en la respuesta: es señal, nunca bloqueo.
# Lo que esta variable controla es si sus hallazgos entran al prompt de
# EVALUACIÓN (nunca al de complementación). Con true el modelo los ve antes de
# juzgar y se ancla en ellos, lo que impide medir su aporte propio.
SMELLS_EN_PROMPT=false

# Vuelve a evaluar la versión reescrita con la misma rúbrica, para ver qué
# criterio se movió. Cuesta una llamada extra al modelo, por eso va apagada.
# No deriva veredicto ni cambia el flujo: es medición.
REEVALUAR_COMPLEMENTACION=false
